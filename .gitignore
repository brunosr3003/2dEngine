# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Dev SQLite DB (sobrescrito pelo Postgres; local apenas)
/data/

# Frontend build artifacts
node_modules/
dist/
.vite/

# macOS
.DS_Store

# Session resume stubs
2026-*-this-session-is-being-continued*.txt

# Local client/server settings
.mmo2d-settings.txt
.mmo2d-creds.txt

# Secrets — NAO commitar
.env
.env.local
*.env

# Editor / server map assets (binarios gerados, nao versionados ainda)
crates/server/assets/*.bin


# Asset packs de terceiros (nao commitar — sao grandes e tem licenca)
assets/manaseed_raw/

# Build cruzado pro VPS (Docker). 750 MB de artefato.
/target-vps

# Cache do campo de altura das ilhas: derivado da SEMENTE, regenerado em ~3s
# no primeiro boot. 20 MB por ilha grande e sem valor nenhum no historico.
/data/ilhas

# Bytecode do Python (as ferramentas de arte sao scripts, nao pacote)
__pycache__/
*.pyc
